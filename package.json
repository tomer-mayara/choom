{
  "name": "choom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.13.0 <27",
    "bun": ">=1.4.4 <1.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.tools.json",
    "check-types": "bun run typecheck",
    "lint": "eslint . --max-warnings 0",
    "habit-hooks": "uvx --from 'habit-hooks[typescript]==1.5.0' habit-hooks",
    "test": "bun run test:native && bun run test:dom",
    "test:native": "bun test --path-ignore-patterns '**/*.test.tsx' ./test/unit",
    "test:dom": "bun test --preload ./test/preload.ts ./test/unit/app.test.tsx",
    "test:rust": "bun run desktop:test",
    "test:watch": "bun test --watch",
    "test:e2e": "bun run test:behavior:browser",
    "test:behavior": "cucumber-js --config cucumber.mjs",
    "test:behavior:native": "cucumber-js --config cucumber.mjs --profile native",
    "test:behavior:browser": "bun run build && bun scripts/run-browser-behavior.ts",
    "test:behavior:packaged": "bun scripts/run-packaged-behavior.ts",
    "check:dependencies": "depcruise src --config .dependency-cruiser.cjs",
    "check:unused": "knip",
    "check:duplicates": "jscpd --config .jscpd.json",
    "check:cookbook": "bun scripts/validate-cookbook.ts",
    "contracts:generate": "bun scripts/contracts/generate.ts --write",
    "check:contracts": "tsp format --check 'cookbook/interfaces/**/*.tsp' && bun scripts/contracts/generate.ts && bun run check-types && bun test ./test/interface",
    "analyze": "bun scripts/analyze.ts",
    "check": "bun run lint && bun run test && bun run test:behavior && bun run check:cookbook && bun run check:contracts && bun run check:dependencies && bun run check:unused && bun run check:duplicates",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "desktop:lint": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "tauri": "tauri",
    "ui:add": "shadcn add",
    "codex": "codex"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "elkjs": "0.12.1",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "zod": "4.6.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@openai/codex": "0.167.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typespec/compiler": "1.17.0",
    "@typespec/json-schema": "1.17.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/old": "npm:typescript@6.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "ts-morph": "28.0.0",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.6",
    "webdriverio": "10.2.0"
  }
}
