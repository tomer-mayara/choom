{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Core window operations, a directory picker, bounded repository reads, and owned dependency-cruiser jobs.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-repository-open",
    "allow-repository-read-text",
    "allow-repository-resolve-paths",
    "allow-repository-close",
    "allow-depcruiser-prepare",
    "allow-depcruiser-run",
    "allow-depcruiser-cancel",
    "allow-depcruiser-release"
  ]
}
