{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@typescript/old"],
  "ignoreBinaries": ["uvx"],
  "entry": [
    "src/domain/generated/contracts.ts",
    "src/platform/generated/contracts.ts",
    "src/architecture/generated/contracts.ts",
    "src/architecture/dependency-cruiser/generated/contracts.ts",
    "src/lib/generated/contracts.ts",
    "scripts/**/*.ts",
    "test/unit/**/*.{ts,tsx}",
    "test/interface/**/*.ts",
    "test/steps/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "scripts/**/*.ts",
    "test/**/*.{ts,tsx}",
    "*.{ts,mjs,cjs}"
  ]
}
