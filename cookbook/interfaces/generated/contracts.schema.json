{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "contracts.schema.json",
    "$defs": {
        "BaselineRuleObject": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BaselineRuleObject.json",
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {
                "$ref": "BaselineRuleValue.json"
            }
        },
        "BaselineRuleValue": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BaselineRuleValue.json",
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "boolean"
                },
                {
                    "type": "number"
                },
                {
                    "type": "null"
                },
                {
                    "$ref": "BaselineRuleObject.json"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "BaselineRuleValue.json"
                    }
                }
            ]
        },
        "BaselineAccessPoints": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BaselineAccessPoints.json",
            "type": "array",
            "items": {
                "$ref": "baselineText.json"
            },
            "minItems": 1
        },
        "baselineText": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "baselineText.json",
            "type": "string",
            "pattern": "\\S"
        },
        "BaselineConsumers": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BaselineConsumers.json",
            "type": "array",
            "items": {
                "$ref": "baselineId.json"
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "baselineId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "baselineId.json",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "BaselineMembership": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BaselineMembership.json",
            "type": "object",
            "properties": {
                "paths": {
                    "type": "array",
                    "items": {
                        "$ref": "baselineSelector.json"
                    },
                    "minItems": 1
                },
                "excludePaths": {
                    "type": "array",
                    "items": {
                        "$ref": "baselineSelector.json"
                    }
                }
            },
            "required": [
                "paths"
            ],
            "additionalProperties": false
        },
        "baselineSelector": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "baselineSelector.json",
            "type": "string",
            "pattern": "\\S"
