        "BaselinePromises": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BaselinePromises.json",
            "type": "object",
            "properties": {
                "behavior": {
                    "anyOf": [
                        {
                            "$ref": "baselineText.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "data": {
                    "anyOf": [
                        {
                            "$ref": "baselineText.json"
                        },
                        {
                            "type": "null"
                        }
