            "type": "object",
            "properties": {
                "value": {
                    "$ref": "baselineText.json"
                },
                "status": {
                    "type": "string",
                    "const": "proposed"
                },
                "evidenceRefs": {
                    "type": "array",
                    "items": {
                        "$ref": "baselineText.json"
                    },
                    "minItems": 1
                }
            },
            "required": [
                "value",
                "status",
                "evidenceRefs"
            ],
            "additionalProperties": false
        },
